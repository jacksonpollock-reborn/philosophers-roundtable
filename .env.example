# Used only by the Prisma CLI (prisma.config.ts) for `npx prisma db push`.
# The running app opens ./dev.db directly (see src/lib/db.ts).
DATABASE_URL="file:./dev.db"

# No API key goes here: the Gemini API key is entered on the /settings page
# and stored in the local SQLite database (dev.db, which is gitignored).
